    public function store(Request $request)
    {
        $jenisPermohonan = $request->input('jenis_permohonan') 
            ?: ($request->input('tipe_pemohon') === 'lembaga' ? 'Lembaga' : 'Individu');

        $request->validate([
            'judul_surat' => 'required|string|max:255',
            'tanggal_surat' => 'required|date',
            'tanggal_pelaksanaan' => 'nullable|date',
            'tanggal_diterima' => 'required|date',
            'uraian_permohonan' => 'nullable|string',
            'lampiran_surat' => 'nullable|file|max:10240',
        ]);

        DB::beginTransaction();
        try {
            $user = Auth::user();
            $personId = $request->input('person_id');
            $lembagaId = $request->input('lembaga_id');
            $mustahikId = null;

            if ($jenisPermohonan === 'Individu') {
                $nik = trim((string)($request->input('p_nik') ?: $request->input('nik')));
                $nama = trim((string)($request->input('p_nama') ?: $request->input('nama')));

                if ($personId) {
                    $person = Person::find($personId);
                } elseif ($nik) {
                    $person = Person::firstOrCreate(
                        ['nik' => $nik],
                        [
                            'nomor_kk' => $request->input('p_nomor_kk'),
                            'nama' => $nama ?: 'Pemohon',
                            'jenis_kelamin' => $request->input('p_jenis_kelamin', 'L'),
                            'telepon' => $request->input('p_telepon'),
                            'alamat' => $request->input('p_alamat'),
                            'id_provinsi' => $request->input('p_id_provinsi'),
                            'id_kabupaten' => $request->input('p_id_kabupaten'),
                            'id_kecamatan' => $request->input('p_id_kecamatan'),
                            'id_kelurahan' => $request->input('p_id_kelurahan'),
                            'kode_pos' => $request->input('p_kode_pos'),
                        ]
                    );
                    $personId = $person->id;
                } elseif ($nama) {
                    $person = Person::create([
                        'nama' => $nama,
                        'nik' => 'TMP' . time() . rand(100, 999),
                        'nomor_kk' => $request->input('p_nomor_kk'),
                        'jenis_kelamin' => $request->input('p_jenis_kelamin', 'L'),
                        'telepon' => $request->input('p_telepon'),
                        'alamat' => $request->input('p_alamat'),
                        'id_provinsi' => $request->input('p_id_provinsi'),
                        'id_kabupaten' => $request->input('p_id_kabupaten'),
                        'id_kecamatan' => $request->input('p_id_kecamatan'),
                        'id_kelurahan' => $request->input('p_id_kelurahan'),
                        'kode_pos' => $request->input('p_kode_pos'),
                    ]);
                    $personId = $person->id;
                }

                $mustahik = $personId ? Mustahik::firstOrCreate(['person_id' => $personId], ['jenis_mustahik' => 'perorangan']) : null;
                if ($mustahik && $request->filled('p_pekerjaan')) {
                    $mustahik->update(['pekerjaan' => $request->input('p_pekerjaan')]);
                }
                $mustahikId = $mustahik?->id;
                $lembagaId = null;
            } else {
                $mustahikId = null;
                if (!$lembagaId && $request->filled('l_nama')) {
                    $lembaga = Lembaga::firstOrCreate(
                        ['nama' => $request->input('l_nama')],
                        [
                            'jenis' => $request->input('l_jenis', 'Masjid'),
                            'ketua_nama' => $request->input('l_ketua_nama'),
                            'telepon' => $request->input('l_telepon'),
                            'alamat' => $request->input('l_alamat'),
                            'id_provinsi' => $request->input('l_id_provinsi'),
                            'id_kabupaten' => $request->input('l_id_kabupaten'),
                            'id_kecamatan' => $request->input('l_id_kecamatan'),
                            'id_kelurahan' => $request->input('l_id_kelurahan'),
                            'kode_pos' => $request->input('l_kode_pos'),
                            'is_upz' => false,
                            'is_active' => true,
                        ]
                    );
                    $lembagaId = $lembaga->id;
                }
            }

            // Snapshots
            $mustahikSnapshotNama = null;
            $mustahikSnapshotNik = null;
            $mustahikSnapshotKontak = null;
            $mustahikSnapshotAlamat = null;
            if ($personId) {
                $pObj = Person::find($personId);
                if ($pObj) {
                    $mustahikSnapshotNama = $pObj->nama;
                    $mustahikSnapshotNik = $pObj->nik;
                    $mustahikSnapshotKontak = $pObj->telepon ?: $pObj->handphone;
                    $mustahikSnapshotAlamat = $pObj->alamat_lengkap;
                }
            }

            $lembagaSnapshotNama = null;
            $lembagaSnapshotKontak = null;
            $lembagaSnapshotAlamat = null;
            if ($lembagaId) {
                $lObj = Lembaga::find($lembagaId);
                if ($lObj) {
                    $lembagaSnapshotNama = $lObj->nama;
                    $lembagaSnapshotKontak = $lObj->telepon ?: $lObj->handphone;
                    $lembagaSnapshotAlamat = $lObj->alamat_lengkap;
                }
            }

            $nomorPengajuan = $this->generateNomorPengajuan($jenisPermohonan);

            $pengajuan = PengajuanBantuan::create([
                'nomor_pengajuan' => $nomorPengajuan,
                'jenis_permohonan' => $jenisPermohonan,
                'mustahik_id' => $mustahikId,
                'lembaga_id' => $lembagaId,
                'mustahik_nama_snapshot' => $mustahikSnapshotNama,
                'mustahik_nik_snapshot' => $mustahikSnapshotNik,
                'mustahik_kontak_snapshot' => $mustahikSnapshotKontak,
                'mustahik_alamat_snapshot' => $mustahikSnapshotAlamat,
                'lembaga_nama_snapshot' => $lembagaSnapshotNama,
                'lembaga_kontak_snapshot' => $lembagaSnapshotKontak,
                'lembaga_alamat_snapshot' => $lembagaSnapshotAlamat,
                'judul_surat' => $request->judul_surat,
                'nomor_surat' => $request->nomor_surat,
                'tanggal_surat' => $request->tanggal_surat,
                'tanggal_pelaksanaan' => $request->tanggal_pelaksanaan,
                'tanggal_diterima' => $request->tanggal_diterima,
                'uraian_permohonan' => $request->uraian_permohonan ?: $request->judul_surat,
                'created_by' => $user->id,
            ]);

            // Save Mustahiks / Program
            $mustahiksInput = $request->input('penerima_manfaat') ?: $request->input('mustahiks', []);
            $createdAnyMustahik = false;

            if (is_array($mustahiksInput) && count($mustahiksInput) > 0) {
                foreach ($mustahiksInput as $mItem) {
                    if (empty($mItem['program_id'])) continue;

                    $mMustahikId = null;
                    $mJenis = $mItem['jenis'] ?? null;
                    $mPersonId = !empty($mItem['person_id']) ? $mItem['person_id'] : null;
                    $mLembagaId = !empty($mItem['lembaga_id']) ? $mItem['lembaga_id'] : null;
                    $mNik = !empty($mItem['nik']) ? trim((string)$mItem['nik']) : null;
                    $mNama = !empty($mItem['nama']) ? trim((string)$mItem['nama']) : null;

                    if ($mPersonId) {
                        $mMustahik = Mustahik::firstOrCreate(['person_id' => $mPersonId], ['jenis_mustahik' => 'perorangan']);
                        $mMustahikId = $mMustahik->id;
                    } elseif ($mLembagaId) {
                        $mMustahik = Mustahik::firstOrCreate(['lembaga_id' => $mLembagaId], ['jenis_mustahik' => 'lembaga']);
                        $mMustahikId = $mMustahik->id;
                    } elseif ($mJenis === 'lembaga' && $mNama) {
                        $mLembaga = Lembaga::firstOrCreate(['nama' => $mNama], [
                            'telepon' => $mItem['telepon'] ?? null,
                            'alamat' => $mItem['alamat'] ?? null,
                            'is_upz' => false,
                            'is_active' => true,
                        ]);
                        $mMustahik = Mustahik::firstOrCreate(['lembaga_id' => $mLembaga->id], ['jenis_mustahik' => 'lembaga']);
                        $mMustahikId = $mMustahik->id;
                    } elseif ($jenisPermohonan === 'Individu' && $mustahikId && (!$mNama || $mNama === $mustahikSnapshotNama)) {
                        $mMustahikId = $mustahikId;
                    } elseif ($mNik) {
                        $mPerson = Person::firstOrCreate(['nik' => $mNik], [
                            'nama' => $mNama ?: 'Mustahik',
                            'telepon' => $mItem['telepon'] ?? null,
                            'alamat' => $mItem['alamat'] ?? null,
                        ]);
                        $mMustahik = Mustahik::firstOrCreate(['person_id' => $mPerson->id], ['jenis_mustahik' => 'perorangan']);
                        $mMustahikId = $mMustahik->id;
                    } elseif ($mNama) {
                        $mPerson = Person::create([
                            'nama' => $mNama,
                            'nik' => 'TMP' . time() . rand(100, 999),
                            'telepon' => $mItem['telepon'] ?? null,
                            'alamat' => $mItem['alamat'] ?? null,
                        ]);
                        $mMustahik = Mustahik::firstOrCreate(['person_id' => $mPerson->id], ['jenis_mustahik' => 'perorangan']);
                        $mMustahikId = $mMustahik->id;
                    } elseif ($mustahikId) {
                        $mMustahikId = $mustahikId;
                    }

                    if ($mMustahikId) {
                        if (!empty($mItem['pekerjaan'])) {
                            Mustahik::where('id', $mMustahikId)->update(['pekerjaan' => $mItem['pekerjaan']]);
                        }
                        $pengajuan->pengajuanMustahiks()->create([
                            'mustahik_id' => $mMustahikId,
                            'program_id' => $mItem['program_id'],
                            'subprogram_id' => !empty($mItem['subprogram_id']) ? $mItem['subprogram_id'] : null,
                            'asnaf_id' => !empty($mItem['asnaf_id']) ? $mItem['asnaf_id'] : null,
                            'keterangan' => !empty($mItem['keterangan']) ? $mItem['keterangan'] : $request->judul_surat,
                            'nominal' => 0,
                            'sumber_dana_id' => $mItem['sumber_dana_id'] ?? null,
                            'bentuk_bantuan' => $mItem['bentuk_bantuan'] ?? 'Uang',
                            'nama_barang' => $mItem['nama_barang'] ?? null,
                            'jumlah_barang' => $mItem['jumlah_barang'] ?? null,
                            'satuan_barang' => $mItem['satuan_barang'] ?? null,
                            'pengadaan_barang_id' => $mItem['pengadaan_barang_id'] ?? null,
                            'jumlah_jiwa' => isset($mItem['jumlah_jiwa']) ? (int)$mItem['jumlah_jiwa'] : 1,
                            'jumlah_kk' => isset($mItem['jumlah_kk']) ? (int)$mItem['jumlah_kk'] : 1,
                        ]);
                        $createdAnyMustahik = true;
                    }
                }
            }

            // Fallback if mustahik array didn't create anything but program_id / mustahikId exists
            if (!$createdAnyMustahik && $mustahikId && $request->filled('program_id')) {
                $nominal = (int) preg_replace('/\D/', '', $request->nominal_diajukan ?? '0');
                $pengajuan->pengajuanMustahiks()->create([
                    'mustahik_id' => $mustahikId,
                    'program_id' => $request->program_id,
                    'subprogram_id' => $request->subprogram_id,
                    'keterangan' => $request->judul_surat,
                    'nominal' => $nominal,
                    'sumber_dana_id' => $request->sumber_dana_id ?? null,
                    'bentuk_bantuan' => $request->bentuk_bantuan ?? 'Uang',
                    'nama_barang' => $request->nama_barang ?? null,
                    'jumlah_barang' => $request->jumlah_barang ?? null,
                    'satuan_barang' => $request->satuan_barang ?? null,
                    'pengadaan_barang_id' => $request->pengadaan_barang_id ?? null,
                    'jumlah_jiwa' => 1,
                    'jumlah_kk' => 1,
                ]);
            }

            // Update jumlah_orang snapshot
            $pengajuan->update([
                'jumlah_orang' => $pengajuan->pengajuanMustahiks()->count() ?: 1,
            ]);

            // Upload Lampiran Surat jika ada
            if ($request->hasFile('lampiran_surat')) {
                $path = $request->file('lampiran_surat')->store('lampiran_pengajuan', 'public');
                $pengajuan->lampirans()->create([
                    'name' => 'Surat Permohonan / Proposal',
                    'category' => 'surat',
                    'file_path' => $path,
                ]);
            }

            // Upload Lampiran Tambahan jika ada
            if ($request->hasFile('lampiran_tambahan')) {
                foreach ($request->file('lampiran_tambahan') as $file) {
                    $path = $file->store('lampiran_pengajuan', 'public');
                    $pengajuan->lampirans()->create([
                        'name' => $file->getClientOriginalName(),
                        'category' => 'pendukung',
                        'file_path' => $path,
                    ]);
                }
            }

            DB::commit();

            return redirect()->route('pengajuan.umum.show', ['pengajuan' => $pengajuan->id])->with('success', 'Pengajuan bantuan umum berhasil dibuat.');
        } catch (\Exception $e) {
            DB::rollBack();
            return back()->withErrors(['error' => 'Gagal membuat pengajuan: ' . $e->getMessage()])->withInput();
        }
    }

    /**
     * Create Person (Identitas Pemohon)
     * POST /pengajuan/umum/person
     */
    public function storePerson(Request $request)
    {
        abort_unless($request->user()->canPerformPengajuanAction('people-search'), 403);

        if (!$request->filled('wilayah_id') && $request->filled('id_kelurahan')) {
            $request->merge(['wilayah_id' => $request->input('id_kelurahan')]);
        }

        $validated = $request->validate([
            'nik' => 'required|string|digits:16|unique:persons,nik',
            'nama' => 'required|string|max:255',
            'nomor_kk' => 'nullable|string|max:20',
            'jenis_kelamin' => 'nullable|in:L,P',
            'tempat_lahir' => 'nullable|string|max:100',
            'tanggal_lahir' => 'nullable|date',
            'telepon' => 'nullable|string|max:30',
            'email' => 'nullable|email|max:100',
            'pekerjaan' => 'nullable|string|max:255',
            'alamat' => 'nullable|string|max:500',
            'wilayah_id' => 'nullable|string|max:50',
            'id_provinsi' => 'nullable|string|max:10',
            'id_kabupaten' => 'nullable|string|max:10',
            'id_kecamatan' => 'nullable|string|max:10',
            'id_kelurahan' => 'nullable|string|max:20',
            'kode_pos' => 'nullable|string|max:10',
        ]);

        $person = Person::create([
            'nik' => $validated['nik'],
            'nomor_kk' => $validated['nomor_kk'] ?? null,
            'nama' => $validated['nama'],
            'jenis_kelamin' => $validated['jenis_kelamin'] ?? 'L',
            'tempat_lahir' => $validated['tempat_lahir'] ?? null,
            'tanggal_lahir' => $validated['tanggal_lahir'] ?? null,
            'telepon' => $validated['telepon'] ?? null,
            'handphone' => $validated['telepon'] ?? null,
            'email' => $validated['email'] ?? null,
            'alamat' => $validated['alamat'] ?? null,
            'id_provinsi' => $validated['id_provinsi'] ?? null,
            'id_kabupaten' => $validated['id_kabupaten'] ?? null,
            'id_kecamatan' => $validated['id_kecamatan'] ?? null,
            'id_kelurahan' => $validated['id_kelurahan'] ?? $validated['wilayah_id'] ?? null,
            'kode_pos' => $validated['kode_pos'] ?? null,
        ]);

        // Create mustahik record untuk person baru
        $mustahik = Mustahik::firstOrCreate(
            ['person_id' => $person->id],
            ['jenis_mustahik' => 'perorangan']
        );

        // Simpan pekerjaan ke mustahik jika ada
        if (!empty($validated['pekerjaan'])) {
            $mustahik->update(['pekerjaan' => $validated['pekerjaan']]);
        }

        return response()->json([
            'id' => $person->id,
            'person_id' => $person->id,
            'nik' => $person->nik,
            'nomor_kk' => $person->nomor_kk,
            'nama' => $person->nama,
            'jenis_kelamin' => $person->jenis_kelamin,
            'tempat_lahir' => $person->tempat_lahir,
            'tanggal_lahir' => $person->tanggal_lahir ? $person->tanggal_lahir->format('Y-m-d') : null,
            'telepon' => $person->telepon,
            'email' => $person->email,
            'pekerjaan' => $mustahik->pekerjaan,
            'alamat' => $person->alamat,
            'id_provinsi' => $person->id_provinsi,
            'id_kabupaten' => $person->id_kabupaten,
            'id_kecamatan' => $person->id_kecamatan,
            'id_kelurahan' => $person->id_kelurahan,
            'kode_pos' => $person->kode_pos,
            'alamat_lengkap' => $person->alamat_lengkap,
        ], 201);
    }

    /**
     * Create Lembaga + Pengurus (Identitas Lembaga)
     * POST /pengajuan/umum/lembaga
     */
    public function storeLembaga(Request $request)
    {
        abort_unless($request->user()->canPerformPengajuanAction('people-search'), 403);

        if (!$request->filled('wilayah_id') && $request->filled('id_kelurahan')) {
            $request->merge(['wilayah_id' => $request->input('id_kelurahan')]);
        }

        $validated = $request->validate([
            'nama' => 'required|string|max:255',
            'jenis' => 'nullable|string|max:100',
            'alamat' => 'required|string|max:500',
            'wilayah_id' => 'nullable|string|max:50',
            'telepon' => 'nullable|string|max:30',
            'email' => 'nullable|email|max:100',
            'id_provinsi' => 'nullable|string|max:10',
            'id_kabupaten' => 'nullable|string|max:10',
            'id_kecamatan' => 'nullable|string|max:10',
            'id_kelurahan' => 'nullable|string|max:20',
            'kode_pos' => 'nullable|string|max:10',
            'pengurus' => 'required|array|min:1',
            'pengurus.*.nik' => 'nullable|string|digits:16',
            'pengurus.*.nama' => 'required|string|max:255',
            'pengurus.*.jabatan' => 'required|in:Ketua,Sekretaris,Bendahara,Anggota',
        ]);

        // Validate exactly 1 Ketua
        $ketua = collect($validated['pengurus'])->firstWhere('jabatan', 'Ketua');
        $ketuaCount = collect($validated['pengurus'])->where('jabatan', 'Ketua')->count();
        if ($ketuaCount !== 1) {
            throw ValidationException::withMessages([
                'pengurus' => ['Harus ada tepat 1 pengurus dengan jabatan Ketua'],
            ]);
        }

        return DB::transaction(function () use ($validated, $ketua) {
            $lembaga = Lembaga::create([
                'nama' => $validated['nama'],
                'jenis' => $validated['jenis'] ?? 'Lainnya',
                'ketua_nama' => $ketua['nama'] ?? null,
                'ketua_nik' => $ketua['nik'] ?? null,
                'telepon' => $validated['telepon'] ?? null,
                'email' => $validated['email'] ?? null,
                'alamat' => $validated['alamat'],
                'id_provinsi' => $validated['id_provinsi'] ?? null,
                'id_kabupaten' => $validated['id_kabupaten'] ?? null,
                'id_kecamatan' => $validated['id_kecamatan'] ?? null,
                'id_kelurahan' => $validated['id_kelurahan'] ?? $validated['wilayah_id'] ?? null,
                'kode_pos' => $validated['kode_pos'] ?? null,
                'is_upz' => false,
                'is_active' => true,
            ]);

            $jabatanMap = PengurusJabatan::whereIn('nama', ['Ketua', 'Sekretaris', 'Bendahara', 'Anggota'])
                ->pluck('id', 'nama')
                ->toArray();

            foreach ($validated['pengurus'] as $pengurusData) {
                $person = null;
                if (!empty($pengurusData['nik'])) {
                    $person = Person::firstOrCreate(
                        ['nik' => $pengurusData['nik']],
                        ['nama' => $pengurusData['nama']]
                    );
                } else {
                    $person = Person::create([
                        'nik' => 'TMP' . time() . rand(100, 999),
                        'nama' => $pengurusData['nama'],
                    ]);
                }

                Pengurus::create([
                    'jenis_pengurus' => 'Lembaga',
                    'lembaga_id' => $lembaga->id,
                    'person_id' => $person->id,
                    'pengurus_jabatan_id' => $jabatanMap[$pengurusData['jabatan']] ?? null,
                    'is_active' => true,
                ]);
            }

            return response()->json([
                'id' => $lembaga->id,
                'lembaga_id' => $lembaga->id,
                'nama' => $lembaga->nama,
                'jenis' => $lembaga->jenis,
                'ketua_nama' => $lembaga->ketua_nama,
                'ketua_nik' => $lembaga->ketua_nik,
                'telepon' => $lembaga->telepon,
                'email' => $lembaga->email,
                'alamat' => $lembaga->alamat,
                'id_provinsi' => $lembaga->id_provinsi,
                'id_kabupaten' => $lembaga->id_kabupaten,
                'id_kecamatan' => $lembaga->id_kecamatan,
                'id_kelurahan' => $lembaga->id_kelurahan,
                'kode_pos' => $lembaga->kode_pos,
                'pengurus' => $validated['pengurus'],
            ], 201);
        });
    }

    /**
     * Update Person (Identitas Pemohon)
     * PUT /pengajuan/umum/person/{id}
     */
    public function updatePerson(Request $request, $id)
    {
        abort_unless($request->user()->canPerformPengajuanAction('people-search'), 403);

        $person = Person::findOrFail($id);

        if (!$request->filled('wilayah_id') && $request->filled('id_kelurahan')) {
            $request->merge(['wilayah_id' => $request->input('id_kelurahan')]);
        }

        $validated = $request->validate([
            'nik' => 'required|string|digits:16|unique:persons,nik,' . $id,
            'nama' => 'required|string|max:255',
            'nomor_kk' => 'nullable|string|max:20',
            'jenis_kelamin' => 'nullable|in:L,P',
            'tempat_lahir' => 'nullable|string|max:100',
            'tanggal_lahir' => 'nullable|date',
            'telepon' => 'nullable|string|max:30',
            'email' => 'nullable|email|max:100',
            'pekerjaan' => 'nullable|string|max:255',
            'alamat' => 'nullable|string|max:500',
            'wilayah_id' => 'nullable|string|max:50',
            'id_provinsi' => 'nullable|string|max:10',
            'id_kabupaten' => 'nullable|string|max:10',
            'id_kecamatan' => 'nullable|string|max:10',
            'id_kelurahan' => 'nullable|string|max:20',
            'kode_pos' => 'nullable|string|max:10',
        ]);

        $person->update([
            'nik' => $validated['nik'],
            'nomor_kk' => $validated['nomor_kk'] ?? $person->nomor_kk,
            'nama' => $validated['nama'],
            'jenis_kelamin' => $validated['jenis_kelamin'] ?? $person->jenis_kelamin,
            'tempat_lahir' => $validated['tempat_lahir'] ?? $person->tempat_lahir,
            'tanggal_lahir' => $validated['tanggal_lahir'] ?? $person->tanggal_lahir,
            'telepon' => $validated['telepon'] ?? $person->telepon,
            'handphone' => $validated['telepon'] ?? $person->handphone,
            'email' => $validated['email'] ?? $person->email,
            'alamat' => $validated['alamat'] ?? $person->alamat,
            'id_provinsi' => $validated['id_provinsi'] ?? $person->id_provinsi,
            'id_kabupaten' => $validated['id_kabupaten'] ?? $person->id_kabupaten,
            'id_kecamatan' => $validated['id_kecamatan'] ?? $person->id_kecamatan,
            'id_kelurahan' => $validated['id_kelurahan'] ?? $validated['wilayah_id'] ?? $person->id_kelurahan,
            'kode_pos' => $validated['kode_pos'] ?? $person->kode_pos,
        ]);

        // Ensure mustahik record exists
        $mustahik = Mustahik::firstOrCreate(
            ['person_id' => $person->id],
            ['jenis_mustahik' => 'perorangan']
        );

        // Update pekerjaan di mustahik
        if (isset($validated['pekerjaan'])) {
            $mustahik->update(['pekerjaan' => $validated['pekerjaan']]);
        }

        return response()->json([
            'id' => $person->id,
            'person_id' => $person->id,
            'nik' => $person->nik,
            'nomor_kk' => $person->nomor_kk,
            'nama' => $person->nama,
            'pekerjaan' => $mustahik->pekerjaan,
            'alamat' => $person->alamat,
            'alamat_lengkap' => $person->alamat_lengkap,
        ]);
    }

    /**
     * Update Lembaga + Pengurus (Identitas Lembaga)
     * PUT /pengajuan/umum/lembaga/{id}
     */
    public function updateLembaga(Request $request, $id)
    {
        abort_unless($request->user()->canPerformPengajuanAction('people-search'), 403);

        $lembaga = Lembaga::findOrFail($id);

        if (!$request->filled('wilayah_id') && $request->filled('id_kelurahan')) {
            $request->merge(['wilayah_id' => $request->input('id_kelurahan')]);
        }

        $validated = $request->validate([
            'nama' => 'required|string|max:255',
            'jenis' => 'nullable|string|max:100',
            'alamat' => 'required|string|max:500',
            'wilayah_id' => 'nullable|string|max:50',
            'telepon' => 'nullable|string|max:30',
            'email' => 'nullable|email|max:100',
            'id_provinsi' => 'nullable|string|max:10',
            'id_kabupaten' => 'nullable|string|max:10',
            'id_kecamatan' => 'nullable|string|max:10',
            'id_kelurahan' => 'nullable|string|max:20',
            'kode_pos' => 'nullable|string|max:10',
            'pengurus' => 'required|array|min:1',
            'pengurus.*.nik' => 'nullable|string|digits:16',
            'pengurus.*.nama' => 'required|string|max:255',
            'pengurus.*.jabatan' => 'required|in:Ketua,Sekretaris,Bendahara,Anggota',
        ]);

        // Validate exactly 1 Ketua
        $ketua = collect($validated['pengurus'])->firstWhere('jabatan', 'Ketua');
        $ketuaCount = collect($validated['pengurus'])->where('jabatan', 'Ketua')->count();
        if ($ketuaCount !== 1) {
            throw ValidationException::withMessages([
                'pengurus' => ['Harus ada tepat 1 pengurus dengan jabatan Ketua'],
            ]);
        }

        return DB::transaction(function () use ($lembaga, $validated, $ketua) {
            $lembaga->update([
                'nama' => $validated['nama'],
                'jenis' => $validated['jenis'] ?? $lembaga->jenis,
                'ketua_nama' => $ketua['nama'] ?? $lembaga->ketua_nama,
                'ketua_nik' => $ketua['nik'] ?? $lembaga->ketua_nik,
                'telepon' => $validated['telepon'] ?? $lembaga->telepon,
                'email' => $validated['email'] ?? $lembaga->email,
                'alamat' => $validated['alamat'],
                'id_provinsi' => $validated['id_provinsi'] ?? $lembaga->id_provinsi,
                'id_kabupaten' => $validated['id_kabupaten'] ?? $lembaga->id_kabupaten,
                'id_kecamatan' => $validated['id_kecamatan'] ?? $lembaga->id_kecamatan,
                'id_kelurahan' => $validated['id_kelurahan'] ?? $validated['wilayah_id'] ?? $lembaga->id_kelurahan,
                'kode_pos' => $validated['kode_pos'] ?? $lembaga->kode_pos,
            ]);

            // Delete existing pengurus
            Pengurus::where('lembaga_id', $lembaga->id)->delete();

            $jabatanMap = PengurusJabatan::whereIn('nama', ['Ketua', 'Sekretaris', 'Bendahara', 'Anggota'])
                ->pluck('id', 'nama')
                ->toArray();

            foreach ($validated['pengurus'] as $pengurusData) {
                $person = null;
                if (!empty($pengurusData['nik'])) {
                    $person = Person::firstOrCreate(
                        ['nik' => $pengurusData['nik']],
                        ['nama' => $pengurusData['nama']]
                    );
                } else {
                    $person = Person::create([
                        'nik' => 'TMP' . time() . rand(100, 999),
                        'nama' => $pengurusData['nama'],
                    ]);
                }

                Pengurus::create([
                    'jenis_pengurus' => 'Lembaga',
                    'lembaga_id' => $lembaga->id,
                    'person_id' => $person->id,
                    'pengurus_jabatan_id' => $jabatanMap[$pengurusData['jabatan']] ?? null,
                    'is_active' => true,
                ]);
            }

            return response()->json([
                'id' => $lembaga->id,
                'lembaga_id' => $lembaga->id,
                'nama' => $lembaga->nama,
                'jenis' => $lembaga->jenis,
                'ketua_nama' => $lembaga->ketua_nama,
                'ketua_nik' => $lembaga->ketua_nik,
                'telepon' => $lembaga->telepon,
                'email' => $lembaga->email,
                'alamat' => $lembaga->alamat,
                'id_provinsi' => $lembaga->id_provinsi,
                'id_kabupaten' => $lembaga->id_kabupaten,
                'id_kecamatan' => $lembaga->id_kecamatan,
                'id_kelurahan' => $lembaga->id_kelurahan,
                'kode_pos' => $lembaga->kode_pos,
                'pengurus' => $validated['pengurus'],
            ]);
        });
    }
}
